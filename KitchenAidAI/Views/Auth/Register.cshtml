@model KitchenAidAI.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registracija";
    Layout = "_LayoutLogin";
}

<section class="hero-section">
    <h1>Registracija</h1>
    <p class="lead">Kreirajte novi racun i zapocnite kulinarsko putovanje.</p>
</section>

<div class="main-cta-section">
    <article class="card-y2k cta-card" style="width: min(620px, 100%);">
        <form asp-action="Register" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label asp-for="Ime" class="form-label">Ime</label>
                <div class="autocomplete" data-autocomplete-url="@Url.Action("UserFieldSearch", "Auth")" data-autocomplete-field="ime" data-autocomplete-min-length="1">
                    <input asp-for="Ime" class="form-control autocomplete-input" autocomplete="off" placeholder="Pocni tipkati ime..." />
                    <div class="autocomplete-menu" role="listbox"></div>
                </div>
                <span asp-validation-for="Ime" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Prezime" class="form-label">Prezime</label>
                <div class="autocomplete" data-autocomplete-url="@Url.Action("UserFieldSearch", "Auth")" data-autocomplete-field="prezime" data-autocomplete-min-length="1">
                    <input asp-for="Prezime" class="form-control autocomplete-input" autocomplete="off" placeholder="Pocni tipkati prezime..." />
                    <div class="autocomplete-menu" role="listbox"></div>
                </div>
                <span asp-validation-for="Prezime" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    { "FieldName", nameof(Model.DatumRodenja) },
                    { "Label", "Datum rodenja" },
                    { "Value", Model.DatumRodenja },
                    { "IncludeTime", false }
                })
                <span asp-validation-for="DatumRodenja" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Zemlja" class="form-label">Zemlja</label>
                <div class="autocomplete" data-autocomplete-url="@Url.Action("CountrySearch", "Auth")">
                    <input asp-for="Zemlja" class="form-control autocomplete-input" autocomplete="off" placeholder="Pocni tipkati zemlju..." />
                    <div class="autocomplete-menu" role="listbox"></div>
                </div>
                <span asp-validation-for="Zemlja" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="autocomplete" data-autocomplete-url="@Url.Action("UserFieldSearch", "Auth")" data-autocomplete-field="email" data-autocomplete-min-length="1">
                    <input asp-for="Email" class="form-control autocomplete-input" autocomplete="off" placeholder="Pocni tipkati email..." />
                    <div class="autocomplete-menu" role="listbox"></div>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Username" class="form-label">Korisnicko ime</label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label">Lozinka</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Preferencije prehrane</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (KitchenAidAI.Models.Enums.PreferencijaPrehrane pref in Enum.GetValues(typeof(KitchenAidAI.Models.Enums.PreferencijaPrehrane)))
                    {
                        var isChecked = Model.SelectedPreferences.Contains(pref);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedPreferences" value="@pref" checked="@(isChecked ? "checked" : null)" />
                            <label class="form-check-label">@pref</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="SelectedPreferences" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-y2k">Registriraj se</button>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-y2k btn-y2k-secondary">Povratak na prijavu</a>
            </div>
        </form>
    </article>
</div>
