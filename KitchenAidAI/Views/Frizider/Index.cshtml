@model KitchenAidAI.Models.Frizider

@{
    ViewData["Title"] = "Frižider";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<section class="hero-section">
    <h1>Frižider korisnika @ViewBag.UserName</h1>
</section>

<div class="main-cta-section" style="align-items: stretch;">
    <article class="card-y2k" style="width: min(920px, 100%);">
        <h2>Namirnice</h2>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <input type="search"
                   class="form-control"
                   style="max-width: 320px;"
                   placeholder="Pretraži namirnice..."
                   data-search-input
                   data-search-url="@Url.Action("Search", "Frizider", new { userId = ViewBag.UserId })"
                   data-search-target="#fridge-items" />
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-y2k" asp-controller="Namirnice" asp-action="Create" asp-route-friziderId="@Model.id">Dodaj namirnicu</a>
        </div>
        <div id="fridge-items">
            @await Html.PartialAsync("_FridgeItems", Model.namirnice?.ToList() ?? new List<KitchenAidAI.Models.Namirnica>())
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-y2k" asp-controller="Recepti" asp-action="Index">Predloži recepte</a>
            @if (isAdmin)
            {
                <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Korisnici" asp-action="Index">Natrag na korisnike</a>
            }
            else
            {
                <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Korisnici" asp-action="Details" asp-route-id="@ViewBag.UserId">Natrag na profil</a>
            }
        </div>
    </article>
</div>
