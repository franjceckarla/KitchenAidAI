@model KitchenAidAI.Models.DTOs.UserDto

@{
    ViewData["Title"] = "Profil korisnika";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<section class="hero-section">
    <h1>@Model.username</h1>
</section>

<div class="main-cta-section">
    <article class="card-y2k cta-card" style="width: 420px; max-width: 100%;">
        <h2>Profil</h2>
        @if (isAdmin)
        {
            if (Model.isDeleted)
            {
                <div class="alert alert-danger" role="alert">Korisnik je označen kao obrisan.</div>
            }
            else
            {
                <div class="alert alert-success" role="alert">Korisnik je aktivan.</div>
            }
        }
        <p><strong>Email:</strong> @Model.email</p>
        <p><strong>Preferencija:</strong> @Model.preferencijaPrehrane</p>
        <div class="d-grid gap-3">
            <a class="btn btn-y2k" asp-controller="Frizider" asp-action="Index" asp-route-userId="@Model.id">Otvori Frižider</a>
            <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Datoteke" asp-action="Index" asp-route-userId="@Model.id">Pregled datoteka</a>
            <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Korisnici" asp-action="Edit" asp-route-id="@Model.id">Uredi profil</a>
            <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Recepti" asp-action="Index">Preporučeni Recepti</a>
            @if (isAdmin)
            {
                <a class="btn btn-y2k btn-y2k-tertiary" asp-controller="Korisnici" asp-action="Index">Nazad na korisnike</a>
            }
            else
            {
                <a class="btn btn-y2k btn-y2k-tertiary" asp-controller="Home" asp-action="Index">Nazad na glavnu stranicu</a>
            }
        </div>
    </article>
</div>
