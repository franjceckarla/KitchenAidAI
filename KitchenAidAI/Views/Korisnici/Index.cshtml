@model IReadOnlyList<KitchenAidAI.Models.User>

@{
    ViewData["Title"] = "Korisnici";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<section class="hero-section">
    <h1 class="fade-in-element">Korisnici</h1>
    <p class="lead fade-in-element">Odaberi korisnika i nastavi prema njegovom frizideru i receptima.</p>
</section>

@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-warning text-center" role="alert">
        @warning
    </div>
}

<div class="row g-4">
    <div class="col-12">
        <article class="card-y2k" style="max-width: 520px;">
            <h2>Pretraga</h2>
            <p>Pronađi korisnika prema imenu ili emailu.</p>
            <input type="search"
                   class="form-control"
                   placeholder="Pretraži korisnike..."
                   data-search-input
                   data-search-url="@Url.Action("Index", "Korisnici")"
                   data-search-target="#user-cards" />
            @if (isAdmin)
            {
                <div class="mt-3">
                    <a class="btn btn-y2k" asp-controller="Korisnici" asp-action="Create">Dodaj korisnika</a>
                </div>
            }
        </article>
    </div>
    <div class="col-12">
        <div id="user-cards" class="contents">
            @await Html.PartialAsync("_UserCards", Model)
        </div>
    </div>
</div>
