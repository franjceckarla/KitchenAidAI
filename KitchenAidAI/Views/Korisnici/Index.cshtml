@model IReadOnlyList<KitchenAidAI.Models.DTOs.UserDto>

@{
    ViewData["Title"] = "Korisnici";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var query = Context.Request.Query;
}

<section class="hero-section">
    <h1 class="fade-in-element">Korisnici</h1>
    <p class="lead fade-in-element">Odaberi korisnika i nastavi prema njegovom frizideru i receptima.</p>
</section>

@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-warning text-center" role="alert">
        @warning
    </div>
}

<div class="row g-4">
    <div class="col-12">
        <article class="card-y2k" style="max-width: 920px;">
            <h2>Pretraga</h2>
            <p>Pronađi korisnika prema imenu, emailu ili preferencijama.</p>
            <form method="get"
                  data-search-form
                  data-search-url="@Url.Action("Index", "Korisnici")"
                  data-search-target="#user-cards">
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <input type="search"
                               name="search"
                               class="form-control"
                               placeholder="Pretraži korisnike..."
                               value="@query["search"]" />
                    </div>
                    @if (isAdmin)
                    {
                        <div class="col-6 col-lg-3">
                            <input type="text"
                                   name="username"
                                   class="form-control"
                                   placeholder="Username"
                                   value="@query["username"]" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <input type="text"
                                   name="email"
                                   class="form-control"
                                   placeholder="Email"
                                   value="@query["email"]" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <input type="text"
                                   name="zemlja"
                                   class="form-control"
                                   placeholder="Zemlja"
                                   value="@query["zemlja"]" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <select name="preferencijaPrehrane" class="form-control">
                                <option value="">Preferencija (sve)</option>
                                @foreach (var value in Enum.GetValues<KitchenAidAI.Models.Enums.PreferencijaPrehrane>())
                                {
                                    <option value="@value" selected="@(query["preferencijaPrehrane"] == value.ToString())">@value</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-lg-3">
                            <select name="isDeleted" class="form-control">
                                <option value="">Status (svi)</option>
                                <option value="false" selected="@(query["isDeleted"] == "false")">Aktivni</option>
                                <option value="true" selected="@(query["isDeleted"] == "true")">Obrisani</option>
                            </select>
                        </div>
                        <div class="col-6 col-lg-3">
                            <input type="date"
                                   name="odDatuma"
                                   class="form-control"
                                   value="@query["odDatuma"]" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <input type="date"
                                   name="doDatuma"
                                   class="form-control"
                                   value="@query["doDatuma"]" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <select name="sortBy" class="form-control">
                                <option value="">Sortiraj po...</option>
                                <option value="username" selected="@(query["sortBy"] == "username")">Username</option>
                                <option value="email" selected="@(query["sortBy"] == "email")">Email</option>
                                <option value="kreirano" selected="@(query["sortBy"] == "kreirano")">Datum</option>
                            </select>
                        </div>
                        <div class="col-6 col-lg-3">
                            <select name="sortDir" class="form-control">
                                <option value="asc" selected="@(query["sortDir"] != "desc")">Uzlazno</option>
                                <option value="desc" selected="@(query["sortDir"] == "desc")">Silazno</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       name="includeAdmins"
                                       value="true"
                                       @(query["includeAdmins"] == "true" ? "checked" : null) />
                                Uključi admin korisnike
                            </label>
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       name="includeDeleted"
                                       value="true"
                                       @(query["includeDeleted"] == "true" ? "checked" : null) />
                                Uključi obrisane
                            </label>
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       name="hasUploadedFiles"
                                       value="true"
                                       @(query["hasUploadedFiles"] == "true" ? "checked" : null) />
                                Samo korisnici s datotekama
                            </label>
                        </div>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (isAdmin)
                    {
                        <a class="btn btn-y2k" asp-controller="Korisnici" asp-action="Create">Dodaj korisnika</a>
                    }
                    <a class="btn btn-y2k btn-y2k-secondary" href="@Url.Action("Index", "Korisnici")">Resetiraj</a>
                </div>
            </form>
        </article>
    </div>
    <div class="col-12">
        <div id="user-cards" class="contents">
            @await Html.PartialAsync("_UserCards", Model)
        </div>
    </div>
</div>
