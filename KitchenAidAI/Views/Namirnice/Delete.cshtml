@model KitchenAidAI.Models.Namirnica

@{
    ViewData["Title"] = "Obriši namirnicu";
}

<section class="hero-section">
    <h1>Obriši namirnicu</h1>
</section>

<div class="main-cta-section">
    <article class="card-y2k cta-card" style="width: min(720px, 100%);">
        <div class="alert alert-warning" role="alert">
            <strong>Upozorenje!</strong> Jeste li sigurni da želite obrisati namirnicu <strong>@Model.naziv</strong> iz frižidera?
        </div>
        
        <div class="row g-3">
            <div class="col-12">
                <p><strong>Naziv:</strong> @Model.naziv</p>
                <p><strong>Kategorija:</strong> @Model.kategorija</p>
                <p><strong>Količina:</strong> @Model.kolicinaUFrizideru @Model.mjera</p>
            </div>
            <div class="col-12 d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.id" method="post">
                    <button type="submit" class="btn btn-y2k btn-y2k-danger">Potvrdi brisanje</button>
                </form>
                <a class="btn btn-y2k btn-y2k-secondary" asp-controller="Frizider" asp-action="Index" asp-route-userId="@ViewBag.UserId">Otkaži</a>
            </div>
        </div>
    </article>
</div>