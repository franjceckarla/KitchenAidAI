<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KitchenAidAI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KitchenAidAI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/y2k-theme/colors.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/y2k-theme/typography.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/y2k-theme/components/buttons.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/y2k-theme/components/cards.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/y2k-theme/components/forms.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/y2k-theme/animations.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.min.css" />
</head>
<body class="login-layout">
    <main role="main" class="login-shell">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
